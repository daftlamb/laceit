{
  "name": "laceit",
  "version": "1.0.0",
  "description": "Turn letters and images into lace.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.daftlamb.laceit",
    "productName": "Lace It",
    "files": [
      "index.html",
      "brush.js",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
